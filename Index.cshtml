@model IEnumerable<ProductCatalog.Models.Product>

@{
    ViewBag.Title = "Product Catalog";
}

<h2>Product Catalog</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Product Name</th>
            <th>Price</th>
            <th>Category</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.ID</td>
                <td>@product.ProductName</td>
                <td>₹@product.Price</td>
                <td>@product.Category</td>

                <td>
                    @Html.ActionLink(
                        "Details",
                        "Details",
                        "Product",
                        new { id = product.ID },
                        null
                    )
                </td>
            </tr>
        }
    </tbody>
</table>
